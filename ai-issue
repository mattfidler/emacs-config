#!/usr/bin/env bash
# ai-issue -- cut a worktree for an issue, and set an agent loose on fixing it.
#
# `claude-issue 1290' puts a branch issue-1290 of the current repository in
# ~/src/<repo>-issue1290, cut from a freshly fetched origin trunk, runs claude
# there, and once claude is waiting for input asks it to fix the issue: check
# no one else is on it and claim it on the issue, so it is clear who is, commit
# and push often, keep the branch merged with the branch it targets, get a clean
# review from an independent reviewer -- agy, else codex, else Claude Fable,
# whichever has credits -- and open the pull request into that branch.  The
# target is the trunk unless AI_ISSUE_BASE names another.  `agy-issue',
# `copilot-issue', `opencode-issue', `kilo-issue' and `codex-issue' do the same
# with antigravity, Copilot, opencode, kilo and Codex.  Like ai-tmux, ai-wt and ai-pr, one
# copy serves every agent and works out which one it is from the name it was
# called by.  This is the shell's `claude-issue' and friends in emacs-config.el.
#
# There is no telling from outside when a terminal program is ready for input,
# so "waiting" means the agent's tmux pane has drawn something and then stayed
# the same for AI_SEND_QUIET seconds.  A watcher left running in the background
# types the request in then, and gives up after AI_SEND_TIMEOUT seconds of an
# agent that never settles.
#
# Running it again for the same issue re-enters the worktree and re-attaches to
# the agent already working there, leaving it to get on with it -- once it has
# claimed the issue: an agent on one not yet assigned to you, nor said on it
# that you are working on it, is asked to claim it first.  A worktree
# whose session has since ended starts an agent, and asks it again.  Agent args
# only reach an agent that is starting, so they are ignored then.
#
# With no argument it lists the open issues that have no worktree yet, and that
# no one else is at work on -- the ones there is still work to start on -- and
# asks which.  Someone else is on an issue when a remote has a branch issue-<N>
# or issue-<N>-part<K>, an open pull request links to it, someone else is
# assigned, or someone else has said so on it; asking for one of those anyway
# says who, and checks before starting.
#
# Usage: claude-issue [ISSUE] [agent args...]
#        agy-issue [ISSUE] [agent args...]
#        copilot-issue [ISSUE] [agent args...]
#        opencode-issue [ISSUE] [agent args...]
#        kilo-issue [ISSUE] [agent args...]
#        codex-issue [ISSUE] [agent args...]
#
# Environment:
#   AI_ISSUE_BASE     the branch the pull request targets (default: the trunk)
#   AI_REVIEWER       the one independent reviewer to name, overriding the chain
#   AI_REVIEWERS      the reviewers to try, in order (default: agy codex kilo fable)
#   AI_<NAME>_OUT_UNTIL  the date that reviewer's credits come back, as
#                     AI_AGY_OUT_UNTIL=2026-11-01; passed over until then
#   AI_ISSUE_PROMPT   what to ask instead; %i is the issue, %r the reviewer and
#                     %t the branch the pull request targets
#   AI_ISSUE_CLAIM_PROMPT  what to ask an agent already at work on an issue not
#                     yet claimed instead; %i is the issue
#   AI_SEND_QUIET     seconds of stillness that mean the agent is waiting (3)
#   AI_SEND_TIMEOUT   seconds to wait for that before giving up (120)

set -uo pipefail

tool=$(basename -- "$0")
tool=${tool%-issue}
case $tool in
    ''|ai)    tool=${AI_TMUX_TOOL:-claude} ;;
    agy)      tool=antigravity ;;
    kilocode) tool=kilo ;;
esac

die() { printf '%s-issue: %s\n' "$tool" "$*" >&2; exit 1; }

# The half of this shared with ai-pr: the session name, the list of what has
# not been started yet, and typing the request in once the agent is waiting.
ask=$(command -v ai-ask) || die "ai-ask is not installed beside this script"
# shellcheck source=ai-ask
. "$ask"

git rev-parse --show-toplevel >/dev/null 2>&1 ||
    die "not inside a git repository"

# The main worktree rather than whichever one we are standing in, so issue
# worktrees stay flat siblings of the repository instead of nesting.
root=$(dirname -- "$(git rev-parse --path-format=absolute --git-common-dir)")

issue=${1-}
if [ $# -gt 0 ]; then
    shift
else
    command -v gh >/dev/null 2>&1 ||
        die "gh is not installed; give the issue number instead"
    # Less the ones someone else is already at work on, and the ones already
    # in a worktree: an agent is living in those.
    claims=$(ai_ask_issue_claims "$root")
    if [ -n "$claims" ]; then
        printf 'Left out, already being worked on:\n' >&2
        printf '%s\n' "$claims" | sed 's/^/  #/' >&2
    fi
    printf 'Open issues:\n' >&2
    gh issue list --limit 50 --json number,title,author \
       --jq '.[] | "\(.number)\t\(.title)\t\(.author.login)"' 2>/dev/null |
        grep -v -E "^($(printf '%s\n' "$claims" | cut -f1 | sort -u |
                        paste -sd'|' -))"$'\t' |
        ai_ask_unstarted "$root" issue >&2 || true
    # Prefer /dev/tty over stdin: this may be started from a pipe.
    [ -t 0 ] || { exec </dev/tty; } 2>/dev/null
    read -r -p "Issue: " issue || die "no issue given"
fi

# Take a number, a #number, or the URL of one -- a comment's included.
issue=${issue%%#issuecomment*}
issue=${issue%/}
issue=${issue##*/}
issue=${issue#\#}
case $issue in
    ''|*[!0-9]*) die "not an issue number: ${issue:-(none)}" ;;
esac

trunk=$(ai_ask_issue_target "$root")
[ -n "$trunk" ] || die "cannot tell what the trunk of $root is"

branch=issue-$issue
worktree="$(dirname -- "$root")/$(basename -- "$root")-issue$issue"

# Before starting anew, make sure no one else already has: a second fix of the
# same issue is wasted on both.
if [ ! -e "$worktree" ]; then
    claims=$(ai_ask_issue_claims "$root" "$issue")
    if [ -n "$claims" ]; then
        printf '#%s is already being worked on:\n' "$issue" >&2
        printf '%s\n' "$claims" | cut -f2- | sed 's/^/  /' >&2
        { [ -t 0 ] || exec </dev/tty; } 2>/dev/null ||
            die "leaving #$issue to them"
        read -r -p "Start on it anyway? [y/N] " answer || answer=
        case $answer in
            [yY]*) ;;
            *) die "leaving #$issue to them" ;;
        esac
    fi
fi

if [ -e "$worktree" ]; then
    [ -d "$worktree" ] || die "$worktree exists and is not a directory"
    printf 'Re-using existing worktree %s\n' "$worktree"
elif git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$root" worktree add -- "$worktree" "$branch" || exit
else
    # Cut from the trunk as origin has it now, not from HEAD: the fix is going
    # to be merged back there.
    git -C "$root" fetch origin "$trunk" || die "could not fetch origin/$trunk"
    git -C "$root" worktree add --no-track -b "$branch" -- "$worktree" \
        "origin/$trunk" || exit
fi

cd "$worktree" || die "cannot enter $worktree"

# <agent>-tmux keeps the conversation alive across Emacs restarts and dropped
# ssh connections; fall back to the bare agent, with no one to ask it anything,
# when it is not installed.
program=$tool-tmux
if ! command -v "$program" >/dev/null 2>&1; then
    case $tool in
        antigravity) program=agy ;;
        *)           program=$tool ;;
    esac
    printf '%s-issue: %s not found; ask the agent to fix #%s yourself\n' \
           "$tool" "$tool-tmux" "$issue" >&2
    exec "$program" "$@"
fi

# Given to ai-tmux explicitly so the watcher knows which pane to type into --
# and so a second run finds the agent already here rather than starting another.
session=$(ai_ask_session)
socket=$tool
prefix=$(printf '%s' "$tool" | tr '[:lower:]-' '[:upper:]_')
export "${prefix}_TMUX_SESSION=$session"

# An agent already at work is left to get on with it -- unless the issue is not
# claimed yet, as one started before claiming was asked for has not: then it is
# asked to do just that.
if tmux -L "$socket" has-session -t "=$session" 2>/dev/null; then
    [ $# -eq 0 ] || printf '%s-issue: agent args ignored\n' "$tool" >&2
    if [ "$(ai_ask_issue_mine "$root" "$issue")" = no ]; then
        claim=${AI_ISSUE_CLAIM_PROMPT:-"Before going on, claim issue #%i, so it is clear who is working on it: assign yourself (\`gh issue edit %i --add-assignee @me') if you can, and comment on the issue that you are working on it"}
        claim=${claim//%i/"$issue"}
        printf '%s is already working in %s; asking it to claim #%s\n' \
               "$tool" "$worktree" "$issue" >&2
        ai_ask_when_ready "$socket" "$session" "$claim" "claiming #$issue" || exit
    else
        printf '%s is already working in %s; nothing sent\n' "$tool" "$worktree" >&2
    fi
    exec "$program"
fi

prompt=${AI_ISSUE_PROMPT:-"Can you fix issue #%i.  Before starting, check that no one else is already working on it: a branch issue-%i or issue-%i-part<N> on any remote (\`git ls-remote --heads'), an open pull request that links to it (\`gh pr list --search %i'), someone else assigned to it, or a comment on it from someone else saying they are working on it.  A claim that is already yours, from an earlier session, is not someone else's: carry on with it.  If anyone else is on it, stop and tell me who and where rather than starting.  Otherwise claim it first, so it is clear who is working on it: assign yourself (\`gh issue edit %i --add-assignee @me') if you can, and comment on the issue that you are starting work on it.  Fix it as a stack of pull requests when it is more than one unit change, so each part is small enough for a human to review and to maintain on its own: the first part stays in this worktree, and each next part gets a worktree of its own beside this one, named as this one with -part2, -part3 and so on added, on a branch issue-%i-part2, issue-%i-part3 and so on cut from the part before it.  Commit and push often.  Whenever origin/%t moves, keep up with it: a single branch by merging origin/%t into it, a stack by rebasing the entire stack onto origin/%t, each part onto the one before it, and pushing with --force-with-lease, so every part shows only its own change.  Once the fix is complete, review it with an independent reviewer (preferring %r) until no issues remain; before fixing a finding, look through the open pull requests (\`gh pr list') for one that already fixes it, and leave any that does to that pull request rather than fixing it again here, naming it in this one's description.  Once the review is clean, the R is formatted with air and the changes are linted, open the pull requests: the first part into %t, and each next part into the part before it.  Monitor them every hour, fixing any CI/CD failures and keeping up with origin/%t the same way; when a part is merged, rebase what is left of the stack onto origin/%t, leaving out the commits that landed there, and point the next part's pull request at %t, so the rest stays ready for human review and integration"}
# Quoted, or bash 5.2 reads an & in the replacement as the text it replaces.
prompt=${prompt//%i/"$issue"}
prompt=${prompt//%r/"$(ai_ask_reviewer_text "$tool")"}
prompt=${prompt//%t/"$trunk"}

ai_ask_when_ready "$socket" "$session" "$prompt" "issue #$issue" || exit

exec "$program" "$@"
