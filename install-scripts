#!/usr/bin/env bash
# install-scripts -- put this repository's scripts on PATH, linked rather than
# copied, so a `git pull' here is all it takes to bring them up to date.
#
# emacs-config.el is loaded straight out of this checkout, but the scripts it
# drives (ai-tmux, ai-pr, ...) used to be copied into ~/.local/bin by setup.sh.
# A machine that pulled without re-running setup.sh -- and setup.sh is not
# something to re-run, it builds Emacs -- ended up with a new Emacs config
# talking to old scripts.  Links into the checkout cannot drift that way.
#
# Safe to run as often as you like: copies left by an older setup.sh are
# replaced by links, and per-agent names for agents no longer listed are
# removed.  Nothing else in ~/.local/bin is touched.
#
# Usage: install-scripts [-n]     -n: say what would change, change nothing

set -euo pipefail

dry=0
case $# in
    0) ;;
    1) [ "$1" = -n ] || { printf 'usage: install-scripts [-n]\n' >&2; exit 2; }
       dry=1 ;;
    *) printf 'usage: install-scripts [-n]\n' >&2; exit 2 ;;
esac

repo=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)

# Links into a worktree break as soon as worktree-cleanup removes it, so only
# the main checkout may be the one everything points at.
if [ "$(git -C "$repo" rev-parse --absolute-git-dir 2>/dev/null)" != \
     "$(cd "$repo" && readlink -f -- "$(git rev-parse --git-common-dir 2>/dev/null)")" ]; then
    printf 'install-scripts: %s is a worktree; run it from the main checkout\n' "$repo" >&2
    exit 1
fi
bin="${HOME}/.local/bin"
config="${HOME}/.config"

# The scripts that go on PATH under their own name.
scripts=(ai-tmux ai-wt ai-pr ai-issue ai-ask
         worktree-cleanup habit-hooks-next-slice emacsreset authinfo-pass
         install-scripts)

# ai-tmux, ai-wt, ai-pr and ai-issue work out which agent they are from the
# name they were called by; each agent gets one name per script.
agents=(claude antigravity agy copilot opencode kilo kilocode codex)
per_agent=(ai-tmux ai-wt ai-pr ai-issue)

run() {
    if [ "$dry" -eq 1 ]; then
        printf 'would: %s\n' "$*"
    else
        "$@"
    fi
}

# Point LINK at TARGET unless it already does.
link() {
    local target=$1 link=$2
    if [ -L "$link" ] && [ "$(readlink -- "$link")" = "$target" ]; then
        return 0
    fi
    if [ -e "$link" ] && [ ! -L "$link" ]; then
        printf 'install-scripts: replacing the copy at %s with a link\n' "$link"
    else
        printf 'install-scripts: %s -> %s\n' "$link" "$target"
    fi
    run ln -sfn -- "$target" "$link"
}

run mkdir -p "$bin" "$config"

for script in "${scripts[@]}"; do
    [ -x "$repo/$script" ] || run chmod 755 "$repo/$script"
    link "$repo/$script" "$bin/$script"
done

for agent in "${agents[@]}"; do
    for script in "${per_agent[@]}"; do
        link "$script" "$bin/$agent-${script#ai-}"
    done
done

# Names left behind for agents that have since been dropped (gemini-tmux and
# the like): any link here that points at one of the per-agent scripts but is
# not one of the names above.
for path in "$bin"/*; do
    [ -L "$path" ] || continue
    case $(readlink -- "$path") in
        ai-tmux|ai-wt|ai-pr|ai-issue) ;;
        *) continue ;;
    esac
    name=$(basename -- "$path")
    keep=0
    for agent in "${agents[@]}"; do
        case $name in
            "$agent"-tmux|"$agent"-wt|"$agent"-pr|"$agent"-issue) keep=1 ;;
        esac
    done
    if [ "$keep" -eq 0 ]; then
        printf 'install-scripts: removing %s, for an agent no longer set up\n' "$path"
        run rm -f -- "$path"
    fi
done

link "$repo/ai-tmux.conf" "$config/ai-tmux.conf"
link "$repo/bash-emacs.sh" "$config/bash-emacs.sh"

if ! grep -qs 'bash-emacs.sh' "${HOME}/.bashrc"; then
    printf 'install-scripts: sourcing bash-emacs.sh from ~/.bashrc\n'
    if [ "$dry" -eq 0 ]; then
        cat >> "${HOME}/.bashrc" <<'EOF'

# Run Emacs through the daemon rather than starting a second one, and add
# emacsreset; see ~/src/emacs-config/README.md
[ -f "$HOME/.config/bash-emacs.sh" ] && . "$HOME/.config/bash-emacs.sh"
EOF
    fi
fi

case ":${PATH}:" in
    *":$bin:"*) ;;
    *) printf 'install-scripts: %s is not on PATH yet; log in again, or add it\n' "$bin" ;;
esac
